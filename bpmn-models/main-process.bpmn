<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_BuildingPermit"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.20.0">

  <bpmn:error id="Error_MissingCriticalDoc" name="MISSING_CRITICAL_DOCUMENT" errorCode="MISSING_CRITICAL_DOCUMENT" />

  <bpmn:process id="BuildingPermitApprovalProcess" name="Municipal Building Permit Approval Process" isExecutable="true">
    
    <!-- STEP 1: START EVENT -->
    <bpmn:startEvent id="Start_ApplicationSubmitted" name="Application Submitted">
      <bpmn:outgoing>Flow_StartToValidate</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- STEP 2: APPLICATION VALIDATION -->
    <bpmn:serviceTask id="Task_ValidateApplication" name="Validate Application Structure">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="validate-application" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="= applicationId" target="applicationId" />
          <zeebe:input source="= buildingType" target="buildingType" />
          <zeebe:input source="= plotArea" target="plotArea" />
          <zeebe:output source="= isValid" target="isApplicationValid" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_StartToValidate</bpmn:incoming>
      <bpmn:outgoing>Flow_ValidateToLandRegistry</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- STEP 2b: LAND REGISTRY CONNECTOR / MOCK SERVICE -->
    <bpmn:serviceTask id="Task_VerifyLandRegistry" name="Verify Land Registry Credentials">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="verify-land-registry" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="= applicationId" target="applicationId" />
          <zeebe:input source="= surveyNumber" target="surveyNumber" />
          <zeebe:output source="= isTitleClear" target="isTitleClear" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ValidateToLandRegistry</bpmn:incoming>
      <bpmn:outgoing>Flow_LandToDocCall</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- STEP 3: CALL ACTIVITY - DOCUMENT VERIFICATION -->
    <bpmn:callActivity id="CallActivity_DocumentVerification" name="Verify Checklist (DocumentVerificationProcess)">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="DocumentVerificationProcess" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="= applicationId" target="applicationId" />
          <zeebe:input source="= documents" target="documents" />
          <zeebe:output source="= documentResults" target="documentResults" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_LandToDocCall</bpmn:incoming>
      <bpmn:outgoing>Flow_DocCallToDeptReviews</bpmn:outgoing>
    </bpmn:callActivity>

    <!-- ERROR BOUNDARY EVENT ON CALL ACTIVITY -->
    <bpmn:boundaryEvent id="Boundary_DocVerificationError" name="Critical Document Missing" attachedToRef="CallActivity_DocumentVerification">
      <bpmn:outgoing>Flow_DocErrorToReject</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_Doc" errorRef="Error_MissingCriticalDoc" />
    </bpmn:boundaryEvent>

    <!-- ERROR PATH -->
    <bpmn:serviceTask id="Task_RejectOnDocError" name="Mark Application Document Rejected">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="update-application-status" />
        <zeebe:ioMapping>
          <zeebe:input source="= applicationId" target="applicationId" />
          <zeebe:input source="= &quot;REJECTED&quot;" target="status" />
          <zeebe:input source="= &quot;Mandatory statutory document check failed&quot;" target="reason" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_DocErrorToReject</bpmn:incoming>
      <bpmn:outgoing>Flow_DocRejectToNotify</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_NotifyDocRejection" name="Notify Applicant of Rejection">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-notification" />
        <zeebe:ioMapping>
          <zeebe:input source="= applicationId" target="applicationId" />
          <zeebe:input source="= &quot;REJECTED&quot;" target="notificationType" />
          <zeebe:input source="= recipientEmail" target="recipientEmail" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_DocRejectToNotify</bpmn:incoming>
      <bpmn:outgoing>Flow_NotifyToEndReject1</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="End_RejectedDocumentError" name="Rejected (Missing Documents)">
      <bpmn:incoming>Flow_NotifyToEndReject1</bpmn:incoming>
    </bpmn:endEvent>

    <!-- STEP 4: PARALLEL MULTI-INSTANCE DEPARTMENT REVIEWS -->
    <bpmn:subProcess id="SubProcess_DepartmentReviews" name="Parallel Departmental Review Process">
      <bpmn:incoming>Flow_DocCallToDeptReviews</bpmn:incoming>
      <bpmn:outgoing>Flow_DeptReviewsToGateway</bpmn:outgoing>

      <bpmn:multiInstanceLoopCharacteristics isSequential="false">
        <bpmn:extensionElements>
          <zeebe:loopCharacteristics inputCollection="= departmentList" inputElement="currentDept" outputCollection="departmentReviews" outputElement="= deptReviewResult" />
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>

      <bpmn:startEvent id="Start_DeptReview" name="Department Review Started">
        <bpmn:outgoing>Flow_SubStartToUserTask</bpmn:outgoing>
      </bpmn:startEvent>

      <bpmn:userTask id="Task_OfficerReview" name="Department Officer Review Task">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:input source="= currentDept" target="assignedDepartment" />
            <zeebe:input source="= applicationId" target="applicationId" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_SubStartToUserTask</bpmn:incoming>
        <bpmn:incoming>Flow_RevisionBackToReview</bpmn:incoming>
        <bpmn:outgoing>Flow_UserTaskToDeptDecision</bpmn:outgoing>
      </bpmn:userTask>

      <!-- Non-Interrupting Timer Boundary Event: Overdue Review Escalation -->
      <bpmn:boundaryEvent id="Boundary_ReviewTimer" name="SLA 48h Overdue Timer" cancelActivity="false" attachedToRef="Task_OfficerReview">
        <bpmn:outgoing>Flow_TimerToEscalate</bpmn:outgoing>
        <bpmn:timerEventDefinition id="TimerEventDefinition_Review">
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT48H</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>

      <bpmn:serviceTask id="Task_EscalateOverdueReview" name="Escalate Overdue Review to Admin">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="handle-review-timeout" />
          <zeebe:ioMapping>
            <zeebe:input source="= applicationId" target="applicationId" />
            <zeebe:input source="= currentDept" target="overdueDepartment" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_TimerToEscalate</bpmn:incoming>
        <bpmn:outgoing>Flow_EscalateToEnd</bpmn:outgoing>
      </bpmn:serviceTask>

      <bpmn:endEvent id="End_EscalationDispatched" name="Escalation Dispatched">
        <bpmn:incoming>Flow_EscalateToEnd</bpmn:incoming>
      </bpmn:endEvent>

      <!-- Exclusive Gateway on Department Decision -->
      <bpmn:exclusiveGateway id="Gateway_DeptDecision" name="Officer Decision?" default="Flow_DecisionApproved">
        <bpmn:incoming>Flow_UserTaskToDeptDecision</bpmn:incoming>
        <bpmn:outgoing>Flow_DecisionApproved</bpmn:outgoing>
        <bpmn:outgoing>Flow_DecisionRevision</bpmn:outgoing>
        <bpmn:outgoing>Flow_DecisionRejected</bpmn:outgoing>
      </bpmn:exclusiveGateway>

      <bpmn:endEvent id="End_DeptApproved" name="Dept Approved">
        <bpmn:incoming>Flow_DecisionApproved</bpmn:incoming>
      </bpmn:endEvent>

      <bpmn:endEvent id="End_DeptRejected" name="Dept Rejected">
        <bpmn:incoming>Flow_DecisionRejected</bpmn:incoming>
      </bpmn:endEvent>

      <!-- STEP 5: EMBEDDED SUB-PROCESS FOR REVISION -->
      <bpmn:subProcess id="BlueprintRevisionProcess" name="Blueprint Revision Sub-Process">
        <bpmn:incoming>Flow_DecisionRevision</bpmn:incoming>
        <bpmn:outgoing>Flow_RevisionBackToReview</bpmn:outgoing>

        <bpmn:startEvent id="Start_Revision" name="Revision Triggered">
          <bpmn:outgoing>Flow_RevStartToStatus</bpmn:outgoing>
        </bpmn:startEvent>

        <bpmn:serviceTask id="Task_SetRevisionStatus" name="Set Status REVISION_REQUESTED">
          <bpmn:extensionElements>
            <zeebe:taskDefinition type="update-application-status" />
            <zeebe:ioMapping>
              <zeebe:input source="= applicationId" target="applicationId" />
              <zeebe:input source="= &quot;REVISION_REQUESTED&quot;" target="status" />
            </zeebe:ioMapping>
          </bpmn:extensionElements>
          <bpmn:incoming>Flow_RevStartToStatus</bpmn:incoming>
          <bpmn:outgoing>Flow_StatusToNotifyRev</bpmn:outgoing>
        </bpmn:serviceTask>

        <bpmn:serviceTask id="Task_NotifyRevision" name="Notify Applicant for Revision">
          <bpmn:extensionElements>
            <zeebe:taskDefinition type="send-notification" />
            <zeebe:ioMapping>
              <zeebe:input source="= applicationId" target="applicationId" />
              <zeebe:input source="= &quot;REVISION_REQUESTED&quot;" target="notificationType" />
              <zeebe:input source="= recipientEmail" target="recipientEmail" />
            </zeebe:ioMapping>
          </bpmn:extensionElements>
          <bpmn:incoming>Flow_StatusToNotifyRev</bpmn:incoming>
          <bpmn:outgoing>Flow_NotifyToUpload</bpmn:outgoing>
        </bpmn:serviceTask>

        <bpmn:userTask id="Task_UploadRevisedBlueprint" name="Applicant Uploads Corrected Blueprint">
          <bpmn:extensionElements>
            <zeebe:ioMapping>
              <zeebe:input source="= applicationId" target="applicationId" />
            </zeebe:ioMapping>
          </bpmn:extensionElements>
          <bpmn:incoming>Flow_NotifyToUpload</bpmn:incoming>
          <bpmn:outgoing>Flow_UploadToRevCheck</bpmn:outgoing>
        </bpmn:userTask>

        <bpmn:exclusiveGateway id="Gateway_RevisionLimit" name="Revision Count &lt;= 3?">
          <bpmn:incoming>Flow_UploadToRevCheck</bpmn:incoming>
          <bpmn:outgoing>Flow_RevLimitValid</bpmn:outgoing>
          <bpmn:outgoing>Flow_RevLimitExceeded</bpmn:outgoing>
        </bpmn:exclusiveGateway>

        <bpmn:endEvent id="End_RevisionSubmitted" name="Revision Complete">
          <bpmn:incoming>Flow_RevLimitValid</bpmn:incoming>
        </bpmn:endEvent>

        <bpmn:endEvent id="End_RevisionExceeded" name="Revision Limit Exceeded">
          <bpmn:incoming>Flow_RevLimitExceeded</bpmn:incoming>
        </bpmn:endEvent>

        <bpmn:sequenceFlow id="Flow_RevStartToStatus" sourceRef="Start_Revision" targetRef="Task_SetRevisionStatus" />
        <bpmn:sequenceFlow id="Flow_StatusToNotifyRev" sourceRef="Task_SetRevisionStatus" targetRef="Task_NotifyRevision" />
        <bpmn:sequenceFlow id="Flow_NotifyToUpload" sourceRef="Task_NotifyRevision" targetRef="Task_UploadRevisedBlueprint" />
        <bpmn:sequenceFlow id="Flow_UploadToRevCheck" sourceRef="Task_UploadRevisedBlueprint" targetRef="Gateway_RevisionLimit" />
        <bpmn:sequenceFlow id="Flow_RevLimitValid" name="Valid cycle" sourceRef="Gateway_RevisionLimit" targetRef="End_RevisionSubmitted">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= revisionCount &lt;= 3</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="Flow_RevLimitExceeded" name="Limit exceeded" sourceRef="Gateway_RevisionLimit" targetRef="End_RevisionExceeded">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= revisionCount &gt; 3</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
      </bpmn:subProcess>

      <bpmn:sequenceFlow id="Flow_SubStartToUserTask" sourceRef="Start_DeptReview" targetRef="Task_OfficerReview" />
      <bpmn:sequenceFlow id="Flow_UserTaskToDeptDecision" sourceRef="Task_OfficerReview" targetRef="Gateway_DeptDecision" />
      <bpmn:sequenceFlow id="Flow_TimerToEscalate" sourceRef="Boundary_ReviewTimer" targetRef="Task_EscalateOverdueReview" />
      <bpmn:sequenceFlow id="Flow_EscalateToEnd" sourceRef="Task_EscalateOverdueReview" targetRef="End_EscalationDispatched" />
      <bpmn:sequenceFlow id="Flow_DecisionApproved" name="Approved" sourceRef="Gateway_DeptDecision" targetRef="End_DeptApproved" />
      <bpmn:sequenceFlow id="Flow_DecisionRevision" name="Revision Requested" sourceRef="Gateway_DeptDecision" targetRef="BlueprintRevisionProcess">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= reviewDecision = &quot;REVISION_REQUESTED&quot;</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_DecisionRejected" name="Rejected" sourceRef="Gateway_DeptDecision" targetRef="End_DeptRejected">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= reviewDecision = &quot;REJECTED&quot;</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_RevisionBackToReview" sourceRef="BlueprintRevisionProcess" targetRef="Task_OfficerReview" />
    </bpmn:subProcess>

    <!-- STEP 6: CONVERGENCE GATEWAY AFTER ALL 4 REVIEWS -->
    <bpmn:exclusiveGateway id="Gateway_AllReviewsApproved" name="All 4 Departments Approved?" default="Flow_AnyReviewRejected">
      <bpmn:incoming>Flow_DeptReviewsToGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_AllApproved</bpmn:outgoing>
      <bpmn:outgoing>Flow_AnyReviewRejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- PERMANENT REJECTION BRANCH -->
    <bpmn:serviceTask id="Task_SetDeptRejectedStatus" name="Set Status REJECTED">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="update-application-status" />
        <zeebe:ioMapping>
          <zeebe:input source="= applicationId" target="applicationId" />
          <zeebe:input source="= &quot;REJECTED&quot;" target="status" />
          <zeebe:input source="= &quot;One or more departments issued a formal rejection&quot;" target="reason" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_AnyReviewRejected</bpmn:incoming>
      <bpmn:outgoing>Flow_RejectStatusToNotify</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_NotifyDeptRejection" name="Notify Applicant of Rejection">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-notification" />
        <zeebe:ioMapping>
          <zeebe:input source="= applicationId" target="applicationId" />
          <zeebe:input source="= &quot;REJECTED&quot;" target="notificationType" />
          <zeebe:input source="= recipientEmail" target="recipientEmail" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_RejectStatusToNotify</bpmn:incoming>
      <bpmn:outgoing>Flow_NotifyToEndReject2</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="End_PermanentRejection" name="Application Permanently Rejected">
      <bpmn:incoming>Flow_NotifyToEndReject2</bpmn:incoming>
    </bpmn:endEvent>

    <!-- STEP 7: CALL ACTIVITY - MUNICIPAL FEE CALCULATION -->
    <bpmn:callActivity id="CallActivity_MunicipalFeeCalc" name="Compute Statutory Fees (MunicipalFeeCalculationProcess)">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="MunicipalFeeCalculationProcess" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="= applicationId" target="applicationId" />
          <zeebe:input source="= buildingType" target="buildingType" />
          <zeebe:input source="= plotArea" target="plotArea" />
          <zeebe:input source="= builtUpArea" target="builtUpArea" />
          <zeebe:input source="= numberOfFloors" target="numberOfFloors" />
          <zeebe:output source="= feeAmount" target="feeAmount" />
          <zeebe:output source="= feeBreakdown" target="feeBreakdown" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_AllApproved</bpmn:incoming>
      <bpmn:outgoing>Flow_FeeToPaymentRequest</bpmn:outgoing>
    </bpmn:callActivity>

    <!-- STEP 8: CREATE PAYMENT REQUEST -->
    <bpmn:serviceTask id="Task_CreatePaymentRequest" name="Create Payment Request">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="create-payment-request" />
        <zeebe:ioMapping>
          <zeebe:input source="= applicationId" target="applicationId" />
          <zeebe:input source="= feeAmount" target="amount" />
          <zeebe:output source="= paymentReference" target="paymentReference" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_FeeToPaymentRequest</bpmn:incoming>
      <bpmn:outgoing>Flow_PaymentReqToUserPay</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- STEP 9: APPLICANT PAYMENT -->
    <bpmn:userTask id="Task_ApplicantPayment" name="Applicant Executes Fee Payment">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:input source="= applicationId" target="applicationId" />
          <zeebe:input source="= feeAmount" target="feeAmount" />
          <zeebe:input source="= paymentReference" target="paymentReference" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_PaymentReqToUserPay</bpmn:incoming>
      <bpmn:outgoing>Flow_UserPayToConfirmPay</bpmn:outgoing>
    </bpmn:userTask>

    <!-- STEP 10: CONFIRM PAYMENT -->
    <bpmn:serviceTask id="Task_ConfirmPayment" name="Confirm Payment via Gateway">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="confirm-payment" />
        <zeebe:ioMapping>
          <zeebe:input source="= applicationId" target="applicationId" />
          <zeebe:input source="= paymentReference" target="paymentReference" />
          <zeebe:output source="= paymentStatus" target="paymentStatus" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_UserPayToConfirmPay</bpmn:incoming>
      <bpmn:outgoing>Flow_ConfirmToGateway</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_PaymentSuccess" name="Payment Succeeded?" default="Flow_PaymentRetry">
      <bpmn:incoming>Flow_ConfirmToGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_PaymentSuccess</bpmn:outgoing>
      <bpmn:outgoing>Flow_PaymentRetry</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- STEP 11: PERMIT GENERATION -->
    <bpmn:serviceTask id="Task_GeneratePermit" name="Generate Building Permit Certificate">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generate-permit" />
        <zeebe:ioMapping>
          <zeebe:input source="= applicationId" target="applicationId" />
          <zeebe:output source="= permitNumber" target="permitNumber" />
          <zeebe:output source="= pdfPath" target="pdfPath" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_PaymentSuccess</bpmn:incoming>
      <bpmn:outgoing>Flow_PermitToNotifyCall</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- STEP 12: CALL ACTIVITY - PERMIT NOTIFICATION -->
    <bpmn:callActivity id="CallActivity_PermitNotification" name="Send Approval Notice (PermitNotificationProcess)">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="PermitNotificationProcess" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="= applicationId" target="applicationId" />
          <zeebe:input source="= &quot;PERMIT_APPROVED&quot;" target="notificationType" />
          <zeebe:input source="= recipientEmail" target="recipientEmail" />
          <zeebe:input source="= permitNumber" target="permitNumber" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_PermitToNotifyCall</bpmn:incoming>
      <bpmn:outgoing>Flow_NotifyToEndSuccess</bpmn:outgoing>
    </bpmn:callActivity>

    <!-- FINAL SUCCESS END EVENT -->
    <bpmn:endEvent id="End_PermitIssued" name="Permit Approved and Issued">
      <bpmn:incoming>Flow_NotifyToEndSuccess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- MAIN PROCESS FLOWS -->
    <bpmn:sequenceFlow id="Flow_StartToValidate" sourceRef="Start_ApplicationSubmitted" targetRef="Task_ValidateApplication" />
    <bpmn:sequenceFlow id="Flow_ValidateToLandRegistry" sourceRef="Task_ValidateApplication" targetRef="Task_VerifyLandRegistry" />
    <bpmn:sequenceFlow id="Flow_LandToDocCall" sourceRef="Task_VerifyLandRegistry" targetRef="CallActivity_DocumentVerification" />
    <bpmn:sequenceFlow id="Flow_DocCallToDeptReviews" sourceRef="CallActivity_DocumentVerification" targetRef="SubProcess_DepartmentReviews" />
    <bpmn:sequenceFlow id="Flow_DocErrorToReject" sourceRef="Boundary_DocVerificationError" targetRef="Task_RejectOnDocError" />
    <bpmn:sequenceFlow id="Flow_DocRejectToNotify" sourceRef="Task_RejectOnDocError" targetRef="Task_NotifyDocRejection" />
    <bpmn:sequenceFlow id="Flow_NotifyToEndReject1" sourceRef="Task_NotifyDocRejection" targetRef="End_RejectedDocumentError" />

    <bpmn:sequenceFlow id="Flow_DeptReviewsToGateway" sourceRef="SubProcess_DepartmentReviews" targetRef="Gateway_AllReviewsApproved" />
    <bpmn:sequenceFlow id="Flow_AllApproved" name="All 4 Approved" sourceRef="Gateway_AllReviewsApproved" targetRef="CallActivity_MunicipalFeeCalc">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= every review in departmentReviews satisfies review.status = &quot;APPROVED&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_AnyReviewRejected" name="Any Rejected" sourceRef="Gateway_AllReviewsApproved" targetRef="Task_SetDeptRejectedStatus" />
    <bpmn:sequenceFlow id="Flow_RejectStatusToNotify" sourceRef="Task_SetDeptRejectedStatus" targetRef="Task_NotifyDeptRejection" />
    <bpmn:sequenceFlow id="Flow_NotifyToEndReject2" sourceRef="Task_NotifyDeptRejection" targetRef="End_PermanentRejection" />

    <bpmn:sequenceFlow id="Flow_FeeToPaymentRequest" sourceRef="CallActivity_MunicipalFeeCalc" targetRef="Task_CreatePaymentRequest" />
    <bpmn:sequenceFlow id="Flow_PaymentReqToUserPay" sourceRef="Task_CreatePaymentRequest" targetRef="Task_ApplicantPayment" />
    <bpmn:sequenceFlow id="Flow_UserPayToConfirmPay" sourceRef="Task_ApplicantPayment" targetRef="Task_ConfirmPayment" />
    <bpmn:sequenceFlow id="Flow_ConfirmToGateway" sourceRef="Task_ConfirmPayment" targetRef="Gateway_PaymentSuccess" />
    <bpmn:sequenceFlow id="Flow_PaymentSuccess" name="Payment Confirmed" sourceRef="Gateway_PaymentSuccess" targetRef="Task_GeneratePermit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= paymentStatus = &quot;SUCCESS&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_PaymentRetry" name="Payment Failed / Retry" sourceRef="Gateway_PaymentSuccess" targetRef="Task_ApplicantPayment" />
    <bpmn:sequenceFlow id="Flow_PermitToNotifyCall" sourceRef="Task_GeneratePermit" targetRef="CallActivity_PermitNotification" />
    <bpmn:sequenceFlow id="Flow_NotifyToEndSuccess" sourceRef="CallActivity_PermitNotification" targetRef="End_PermitIssued" />

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_MainPermit">
