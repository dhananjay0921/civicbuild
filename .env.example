# =============================================================================
# CIVICBUILD ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and configure for local or production deployment
# =============================================================================

# PostgreSQL Configuration
POSTGRES_DB=civicbuild
POSTGRES_USER=civic_user
POSTGRES_PASSWORD=civic_pass
POSTGRES_PORT=5432

# Backend Port & Profile
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=postgres

# Frontend Exposed Port
FRONTEND_PORT=3000

# Camunda 8 Zeebe Configuration
ZEEBE_CLIENT_ENABLED=true
ZEEBE_GATEWAY_ADDRESS=zeebe:26500

# Security (JWT 256-bit Hex secret key)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# File Storage
UPLOAD_DIR=/app/uploads
PERMITS_DIR=/app/generated-permits
